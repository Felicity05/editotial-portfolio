# Server-only variables. Never prefix the token with NEXT_PUBLIC_.
# Create an access token scoped to the Vercel account/team that owns this project.
VERCEL_ANALYTICS_TOKEN=
# Vercel exposes this automatically when system env vars are enabled.
# For local dev: project Settings > General > Project ID (prj_...).
VERCEL_PROJECT_ID=
# Team-owned projects only: team Settings > General > Team ID (team_...).
# Leave empty for a project owned by your personal account.
VERCEL_TEAM_ID=
